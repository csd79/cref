(defun level0 (results)
  (let ((categories (remove-duplicates
                     (mapcar #'first results))))
    (apply #'append
           (mapcar #'(lambda (key)
                       (remove-if-not #'(lambda (list)
                                          (eq (first list) key))
                                      results ))))))



